---
import '../styles/site.css';
import quotes from '../data/quotes.json';
import Header from '../components/site/Header.vue';

const {
  title = 'Zoë Clarno - Senior Software Engineer',
  description = 'Zoë Clarno is a senior software engineer in the Salt Lake area who builds design systems, platform migrations, and the way teams build with AI.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M2 26 L11 12 L16 19 L21 9 L30 26 Z' fill='%233f6b3a'/%3E%3Ccircle cx='24' cy='7' r='3' fill='%23e0a43a'/%3E%3C/svg%3E" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline>try{const t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch{}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<Header />

<main id="main">
  <slot />
</main>

<footer>
  <div class="wrap">
    <p>Built by Zoë Clarno with Astro and Vue, served as plain HTML. No trackers, no web fonts.</p>
    <p>© <span data-year>2026</span> Zoë Clarno</p>
  </div>
</footer>

<script is:inline define:vars={{ quotes }}>
(() => {
  // Theme: light by default; the button switches to dark and remembers the choice (if storage works).
  const root = document.documentElement;
  const KEY = 'theme';
  document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
    const isDark = root.dataset.theme === 'dark';
    root.dataset.theme = isDark ? 'light' : 'dark';
    try { localStorage.setItem(KEY, root.dataset.theme); } catch {}
  });

  // Quotes: a curated set from the original site, pulled from src/data/quotes.json at build time.
  const q = document.querySelector('[data-quote]');
  const a = document.querySelector('[data-author]');
  let i = Math.floor(Math.random() * quotes.length);
  const show = () => { q.textContent = quotes[i].text; a.textContent = '— ' + quotes[i].author; };
  show();
  document.querySelector('[data-next-quote]').addEventListener('click', () => { i = (i + 1) % quotes.length; show(); });

  document.querySelector('[data-year]').textContent = new Date().getFullYear();
})();
</script>
</body>
</html>
